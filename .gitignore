# Dependencies
# extern/includes/ is deliberately vendored (see scripts/README-deps.md), so it
# is tracked rather than ignored. Only the restore scratch is excluded.
.qpm/

# Build and temp directories
build/
temp_qmod/
dist/
target/

# Private / user settings
ndkpath.txt
qpm.private.json
CMakeUserPresets.json
.vscode/
.idea/

# Compiled outputs
*.qmod
*.so
# ...but the vendored native libraries are tracked on purpose.
!extern/libs/*.so
*.dll
*.exe
*.o
*.obj

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env
*.env.*

# Converter test scratch
tools/bundleconvert/work/
__pycache__/
*.pyc

# Coverage and testing
coverage/
htmlcov/

# System files
.DS_Store
Thumbs.db
